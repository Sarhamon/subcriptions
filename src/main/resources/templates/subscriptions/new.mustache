{{>layouts/header}}

<a class="back-btn" href="/subscriptions">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    목록으로
</a>
<div class="page-title">새 구독 등록</div>

<div class="form-card">
    <form action="/subscriptions" method="post">
        <div class="form-group">
            <label class="form-label">서비스명</label>
            <input class="form-input" type="text" name="serviceName" placeholder="예: Netflix, Spotify" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">금액</label>
                <input class="form-input" type="number" name="price" min="0" placeholder="0" required>
            </div>
            <div class="form-group">
                <label class="form-label">통화</label>
                <select class="form-input" name="currency" required>
                    {{#currencies}}
                    <option value="{{name}}">{{label}} ({{name}})</option>
                    {{/currencies}}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">결제 주기</label>
            <select class="form-input" name="billingCycle" required>
                {{#cycles}}
                <option value="{{name}}">{{label}}</option>
                {{/cycles}}
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">시작일</label>
            <input class="form-input" type="date" name="startedAt" required>
        </div>
        <div class="form-group">
            <div class="checkbox-group">
                <input type="checkbox" id="autoRenew" name="autoRenew" value="true">
                <label for="autoRenew">자동 결제</label>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">태그</label>
            <div class="tag-checks">
                {{#allTags}}
                <label class="tag-check">
                    <input type="checkbox" name="tags" value="{{name}}">
                    <span>{{label}}</span>
                </label>
                {{/allTags}}
            </div>
        </div>
        <div class="form-actions">
            <a class="form-cancel" href="/subscriptions">취소</a>
            <button type="submit" class="form-submit">등록하기</button>
        </div>
    </form>
</div>

{{>layouts/footer}}
