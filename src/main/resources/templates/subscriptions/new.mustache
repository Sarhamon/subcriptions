{{! 신규 구독 등록 폼. 제출 시 POST /subscriptions → SubscriptionController.create. }}
{{>layouts/header}}

<h1>구독 등록</h1>

<form action="/subscriptions" method="post">
    <p>
        <label>서비스명<br>
            <input type="text" name="serviceName" required>
        </label>
    </p>
    <p>
        <label>금액<br>
            <input type="number" name="price" min="0" required>
        </label>
    </p>
    {{! 통화/주기 select는 컨트롤러가 enum.values()로 내려준 목록을 그대로 반복 렌더. }}
    <p>
        <label>통화<br>
            <select name="currency" required>
                {{#currencies}}
                <option value="{{name}}">{{label}}</option>
                {{/currencies}}
            </select>
        </label>
    </p>
    <p>
        <label>결제 주기<br>
            <select name="billingCycle" required>
                {{#cycles}}
                <option value="{{name}}">{{label}}</option>
                {{/cycles}}
            </select>
        </label>
    </p>
    <p>
        <label>시작일<br>
            <input type="date" name="startedAt" required>
        </label>
    </p>
    {{! 체크박스: 체크돼야만 form 전송에 포함된다. 미체크 시 false로 바인딩됨. }}
    <p>
        <label>
            <input type="checkbox" name="autoRenew" value="true">
            자동 결제
        </label>
    </p>
    <p>
        <button type="submit">등록</button>
        <a href="/subscriptions">취소</a>
    </p>
</form>

{{>layouts/footer}}
