{{>layouts/header}}

<a class="back-btn" href="/subscriptions/{{subscription.id}}">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    상세로
</a>
<div class="page-title">구독 수정</div>

<div class="form-card">
    <form action="/subscriptions/{{subscription.id}}/update" method="post">
        <div class="form-group">
            <label class="form-label">서비스명</label>
            <input class="form-input" type="text" name="serviceName" value="{{subscription.serviceName}}" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">금액</label>
                <input class="form-input" type="number" name="price" min="0" value="{{subscription.price}}" required>
            </div>
            <div class="form-group">
                <label class="form-label">통화</label>
                <select class="form-input" name="currency" required>
                    {{#currencies}}
                    <option value="{{name}}">{{label}} ({{name}})</option>
                    {{/currencies}}
                </select>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">결제 주기</label>
            <select class="form-input" name="billingCycle" required>
                {{#cycles}}
                <option value="{{name}}">{{label}}</option>
                {{/cycles}}
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">시작일</label>
            <input class="form-input" type="date" name="startedAt" value="{{subscription.startedAt}}" required>
        </div>
        <div class="form-group">
            <div class="checkbox-group">
                <input type="checkbox" id="autoRenew" name="autoRenew" value="true"
                       {{#subscription.autoRenew}}checked{{/subscription.autoRenew}}>
                <label for="autoRenew">자동 결제</label>
            </div>
        </div>
        <div class="form-actions">
            <a class="form-cancel" href="/subscriptions/{{subscription.id}}">취소</a>
            <button type="submit" class="form-submit">저장하기</button>
        </div>
    </form>
</div>

<script>
    document.querySelector('select[name="currency"]').value   = "{{subscription.currency.name}}";
    document.querySelector('select[name="billingCycle"]').value = "{{subscription.billingCycle.name}}";
</script>

{{>layouts/footer}}
