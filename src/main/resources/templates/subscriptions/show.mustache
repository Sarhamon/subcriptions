{{>layouts/header}}

<a class="back-btn" href="/subscriptions">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    목록으로
</a>

<div class="detail-card">
    <div class="detail-header">
        <div class="detail-service">{{subscription.emoji}} {{subscription.serviceName}}</div>
        <div class="detail-price">{{subscription.displayPrice}}</div>
        <div class="detail-cycle">{{subscription.billingCycle.label}}</div>
    </div>
    <div class="detail-rows">
        <div class="detail-row">
            <span class="detail-row-label">시작일</span>
            <span class="detail-row-value">{{subscription.startedAt}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-row-label">다음 갱신일</span>
            <span class="detail-row-value">{{subscription.nextRenewalDate}} ({{subscription.daysText}})</span>
        </div>
        <div class="detail-row">
            <span class="detail-row-label">통화</span>
            <span class="detail-row-value">{{subscription.currency.label}}</span>
        </div>
        <div class="detail-row">
            <span class="detail-row-label">자동결제</span>
            <span class="detail-row-value">
                <span class="badge {{#subscription.autoRenew}}badge-auto{{/subscription.autoRenew}}{{^subscription.autoRenew}}badge-manual{{/subscription.autoRenew}}">
                    {{#subscription.autoRenew}}자동결제{{/subscription.autoRenew}}{{^subscription.autoRenew}}수동결제{{/subscription.autoRenew}}
                </span>
            </span>
        </div>
    </div>
</div>

<div class="action-row">
    <a class="action-btn action-edit" href="/subscriptions/{{subscription.id}}/edit">✏️ 수정</a>
    <form action="/subscriptions/{{subscription.id}}/delete" method="post"
          onsubmit="return confirm('정말 삭제하시겠습니까?');">
        <button type="submit" class="action-btn action-delete">🗑️ 삭제</button>
    </form>
</div>

{{>layouts/footer}}
