{{! 404 전용 에러 뷰. GlobalExceptionHandler가 SubscriptionNotFoundException을 잡아 이쪽으로 보낸다. }}
{{>layouts/header}}

<h1>찾을 수 없습니다 (404)</h1>

{{! 핸들러가 넘긴 message가 있으면 그것을, 없으면 기본 문구를 보여준다. }}
<article>
    <p>{{#message}}{{message}}{{/message}}{{^message}}요청하신 페이지나 자원을 찾을 수 없습니다.{{/message}}</p>
</article>

<p>
    <a href="/subscriptions">구독 목록으로</a>
</p>

{{>layouts/footer}}
