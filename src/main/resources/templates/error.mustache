{{>layouts/header}}

<div class="error-card">
    <div class="error-code">{{#status}}{{status}}{{/status}}{{^status}}오류{{/status}}</div>
    <p class="error-msg">{{#error}}{{error}}{{/error}}{{^error}}알 수 없는 오류가 발생했습니다.{{/error}}</p>
    {{#message}}<div class="error-detail">{{message}}</div>{{/message}}
    <a class="btn btn-primary" href="/">홈으로 돌아가기</a>
</div>

{{>layouts/footer}}
